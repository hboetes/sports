# Description: noctalia greeter for greetd

name=noctalia-greeter
version=git
release=1
branch=main
source=(
    https://github.com/noctalia-dev/noctalia-greeter.git
)

build()
{
    cd $SRC/$name
    meson setup build-release --buildtype=release
    meson compile -C build-release
    DESTDIR=$PKG meson install -C build-release
    # use the right name, check the user setting in /etc/greetd/config.toml
    sed -i 's|greeter greeter|greetd greetd|' $PKG/usr/local/lib/tmpfiles.d/noctalia-greeter.conf
}
