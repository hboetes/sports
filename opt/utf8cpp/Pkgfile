# Description: small library for handling UTF-8 encoded strings.

name=utf8cpp
version=git
release=1
source=(
    https://github.com/nemtrif/utfcpp.git
)

build()
{
    cd $name
    mkdir build
    cd build
    cmake .. -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=ON
    make
    make install DESTDIR=$PKG
}
