# Description:  homage to MS-DOS editor from M$
# URL:          https://github.com/microsoft/edit.git
# Dependencies: rust

name=edit
version=git
release=1
source=(
    https://github.com/microsoft/edit.git
    release.diff
)

build()
{
    export PATH=$PATH:~/.cargo/bin
    cd $name
    patch_apply release
    cargo build --config ./.cargo/release.toml --release
    install -D target/release/$name   $PKG/usr/local/bin/$name
}
