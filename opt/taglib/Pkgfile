# Description: library for reading and editing the metadata of several popular audio formats

name=taglib
version=git
release=1
source=(
    https://github.com/taglib/taglib.git
)

build()
{
    cd $name
    git submodule update --init
    mkdir build
    cd build
    cmake .. -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=ON
    make
    make install DESTDIR=$PKG
}
