# Description: GPU-accelerated terminal emulator

name=alacritty
version=git
release=1
source=(https://github.com/alacritty/alacritty.git)

build()
{
    # For some reason $name only builds with the rustup version.
    export PATH="$PATH:$HOME/.cargo/bin"
    cd $name
    cargo build --release
    install -D target/release/alacritty     $PKG/usr/local/bin/$name
    install -D extra/completions/_alacritty $PKG/usr/local/share/zsh/vendor-completions/_alacritty
    for f in extra/man/*.scd; do
        page=$(basename "$f" .scd)
        sec=${page##*.}
        install -d "$PKG/usr/local/share/man/man$sec"
        scdoc < "$f" | gzip -9 > "$PKG/usr/local/share/man/man$sec/$page.gz"
    done
}
